# Modelo; nao carrega nem ativa configuracao no ambiente principal.
NODE_ENV=production
SECURITY_STORE=mysql
SESSION_SAME_SITE=lax
PUBLIC_FRONTEND_URL=
PUBLIC_API_URL=
# Mesmo segredo de proxy definido na Vercel; nunca usar prefixo VITE_.
ORIGIN_SECRET=
# Derivado de PUBLIC_FRONTEND_URL quando vazio.
PASSWORD_RESET_BASE_URL=
PORT=3000
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Somente para provisionar a conta: host/rede de saída autorizado do serviço.
DB_ACCOUNT_HOST=
DB_SSL=true
# CA do provedor, quando nao pertencer a cadeia confiavel do Node.
DB_SSL_CA_BASE64=
JWT_SECRET=
# Vazio permite somente PUBLIC_FRONTEND_URL.
CORS_ORIGINS=
TRUST_PROXY_HOPS=1
# Ativar SOMENTE apos autorizacao para restringir cadastro publico.
REGISTRATION_MODE=office
PHOTO_STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_PREFIX=vertice/photos
# O SDK tambem aceita identidade de servico; nao usar credenciais pessoais.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN= (se utilizar credenciais temporarias)
# S3_ENDPOINT=https://endpoint-compativel
# S3_FORCE_PATH_STYLE=false
